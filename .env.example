# --- Supabase ---
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Natural language parsing provider ---
# Which provider to use: "anthropic" or "openai". Never exposed to the client —
# only read in server-side route handlers.
AI_PROVIDER=anthropic

# Only the key for the provider you selected above is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the model used for parsing.
# Defaults: claude-3-5-sonnet-latest (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
